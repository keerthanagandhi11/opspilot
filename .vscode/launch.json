{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "OpsPilot: run server",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--app-dir", "backend", "--reload", "--port", "8000", "--no-proxy-headers"],
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    },
    {
      "name": "OpsPilot: run tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "justMyCode": false
    }
  ]
}
