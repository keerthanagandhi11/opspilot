# Copy to .env and fill in. Everything is optional: with no key the app runs in
# "quote mode" and answers with exact sentences from your PDFs.

# Free LLM key from https://console.groq.com/keys (no credit card needed)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Alternatives (any OpenAI-compatible endpoint works):
# Google Gemini free tier:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.0-flash
# OpenRouter free models:   LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Local Ollama (offline):   LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.2  LLM_API_KEY=ollama

# Agent (agentic RAG): the LLM plans, calls search tools, answers, then self-checks
AGENT_ENABLED=true
AGENT_MAX_STEPS=5
AGENT_VERIFY=true

# Retrieval
ENABLE_EMBEDDINGS=true
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TOP_K=5

# Limits
MAX_FILES=10
MAX_FILE_MB=15
SESSION_TTL_MINUTES=60
RATE_LIMIT_PER_MINUTE=30
